# LINA environment. Copy to .env and fill in. Never commit .env.
# Docker Compose reads this file; the backend and `npm run dev` read it for local runs too.

# --- Site ---
SITE_URL=http://localhost:3000
DEFAULT_LOCALE=sw

# --- Database ---
POSTGRES_PASSWORD=lina
# Used only when running the backend outside Docker (Compose sets its own value).
DATABASE_URL=postgresql+psycopg://lina:lina@localhost:5433/lina

# --- Web <-> API ---
# Shared secret the Next.js server sends to the API's /internal routes.
# Generate with: openssl rand -hex 32
INTERNAL_API_TOKEN=
# Used only when running `npm run dev` outside Docker (Compose sets its own value).
API_INTERNAL_URL=http://localhost:8000

# --- Admin login (Auth.js + GitHub OAuth) ---
# Generate with: openssl rand -base64 32
AUTH_SECRET=
# GitHub > Settings > Developer settings > OAuth Apps > New OAuth App
#   Homepage URL:      http://localhost:3000
#   Callback URL:      http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# The one GitHub account allowed into /admin.
ADMIN_GITHUB_USERNAME=

# --- Fetching sources ---
# A public page that says who runs the bot and how to reach you (e.g. https://[DOMAIN]/bot).
# It is sent with every request. The pipeline refuses to fetch until this is set.
BOT_CONTACT_URL=
# Minimum seconds between two requests to the same site.
FETCH_DELAY_SECONDS=5
# Most detail pages fetched in one run.
MAX_ITEMS_PER_RUN=60

# --- Extraction (Claude API) ---
# Create a key at https://platform.claude.com/ . The pipeline refuses to extract without it.
ANTHROPIC_API_KEY=
# Model for reading pages and writing summaries.
EXTRACT_MODEL=claude-haiku-5-5
# Stronger model, used only when the first answer is low-confidence or fails an evidence check.
REVIEW_MODEL=claude-sonnet-5-5
# The pipeline stops extracting for the day once its estimated spend reaches this (USD).
MAX_DAILY_LLM_USD=2
